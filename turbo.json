{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "cache": true,
      "outputs": [".next/**", "out/**"],
      "env": [
        "NEXT_PUBLIC_PROJECT_ID",
        "NEXT_PUBLIC_BASE_PATH",
        "NEXT_PUBLIC_API_BASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    "next.config.mjs",
    "tsconfig.json",
    "package.json"
  ]
}

